# Copy to .env and fill in; `python -m app.run` reads it. Never commit .env (it is git-ignored).
# AWS credentials come from `aws configure`, not this file.
AWS_REGION=ap-southeast-1
KENA_LIVE=1                       # 1 = really send via AWS; 0 = simulated channels
KENA_LIVE_CHANNELS=SES            # only these go through AWS; WhatsApp/RCS/SMS appear on http://127.0.0.1:8000/device
KENA_AGENT=claude                 # claude = Claude on Amazon Bedrock; local = free rules agent
KENA_MODEL=anthropic.claude-opus-5-5
KENA_CUSTOMER_NAME=Alex
KENA_CUSTOMER_PHONE=+6591234567   # YOUR personal WhatsApp number: it plays the bank customer
KENA_CUSTOMER_EMAIL=you@example.com
KENA_SES_SENDER=you@example.com   # SES-verified address used as From
KENA_WABA_ID=waba-xxxxxxxx        # from: python scripts/connect_local.py list
KENA_WA_PHONE_NUMBER_ID=phone-number-id-xxxxxxxx
KENA_WA_TEMPLATE=                 # optional approved template, e.g. kena_transfer_alert
KENA_SMS_IDENTITY=                # optional SMS origination identity
KENA_SNS_TOPIC_ARN=               # printed by: python scripts/connect_local.py setup
KENA_NO_RESPONSE_SECONDS=90       # seconds before the agent follows up on silence
KENA_ALERT_EMAIL=1                # also email the customer when a transfer is flagged
KENA_BASIC_AUTH=kena:change-me    # protects the dashboard, which the tunnel makes public
